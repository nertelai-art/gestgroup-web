# Adreça pública del web (per a les metadades, el sitemap, les dades estructurades i l'origen de
# l'enllaç «Web feta per Nertel»). Per defecte, https://gestgroup-web.vercel.app
NEXT_PUBLIC_SITE_URL=

# «true» només quan el web sigui al domini del client: obre la indexació (robots i meta robots).
SITE_INDEXABLE=

# --- Formulari d'anàlisi gratuïta (src/lib/contact-mail.ts) ---
# S'envia per SMTP amb una bústia de gestgroup.es que dona Gestgroup. Sense servidor, usuari,
# contrasenya i destinatari, no s'envia enlloc (la resposta diu delivered: false).
# Servidor SMTP (el del seu allotjament, o el de Microsoft 365).
CONTACT_SMTP_HOST=
# 587 (STARTTLS) per defecte; 465 si el servidor només fa TLS directe.
CONTACT_SMTP_PORT=
# Usuari i contrasenya de la bústia que envia (secret: només a Vercel i a .env.local).
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=
# Remitent. Per defecte, l'usuari. Ha de ser una adreça de gestgroup.es que el servidor deixi fer servir.
CONTACT_MAIL_FROM=
# On arriben les sol·licituds (una o diverses, separades per comes).
CONTACT_MAIL_TO=
