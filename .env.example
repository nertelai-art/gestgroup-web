# Adreça pública del web (per a les metadades, el sitemap, les dades estructurades i l'origen de
# l'enllaç «Web feta per Nertel»). Per defecte, https://gestgroup-web.vercel.app
NEXT_PUBLIC_SITE_URL=

# «true» només quan el web sigui al domini del client: obre la indexació (robots i meta robots).
SITE_INDEXABLE=

# --- Formulari d'anàlisi gratuïta (src/lib/contact-mail.ts, enviat amb Resend) ---
# Sense les tres, no s'envia enlloc (la resposta diu delivered: false).
# Clau d'API de Resend (https://resend.com/api-keys), només d'enviament. Només servidor; mai NEXT_PUBLIC_.
RESEND_API_KEY=
# Remitent d'un domini verificat a Resend, p. ex. "Web Gestgroup <web@nertel.ai>".
MAIL_FROM=
# On arriben les sol·licituds (una o diverses, separades per comes).
MAIL_TO=
