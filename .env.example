# Adreça pública del web (per a les metadades, el sitemap i les dades estructurades).
# Per defecte, https://gestgroup-web.vercel.app
NEXT_PUBLIC_SITE_URL=

# «true» només quan el web sigui al domini del client: obre la indexació (robots i meta robots).
SITE_INDEXABLE=

# --- Demo per a un lead (src/demo-kit) ---
# Amb DEMO_SECRET i DEMO_SITE, només s'entra amb un enllaç personal; la resta veu la pàgina de
# bloqueig de Nertel. Sense DEMO_SECRET, el web és obert.
# Secret per signar els enllaços (un per web; es genera, no s'escriu mai aquí).
DEMO_SECRET=
# Identificador de la web dins del kit i de PostHog: gestgroup.
DEMO_SITE=
# Adreça pública de la demo, per a l'ordre que fa els enllaços (pnpm demo:link).
DEMO_URL=
# Leads anul·lats, separats per comes (l'identificador que surt a PostHog).
DEMO_REVOKED=
# Webhook que rep un avís quan un lead obre la demo en un navegador nou (n8n, Slack…). Opcional.
DEMO_NOTIFY_URL=

# PostHog (núvol de la UE), el mateix projecte per a totes les demos. La clau de projecte és pública.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
